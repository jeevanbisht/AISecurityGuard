# AI guard
SQL_INJECTION_MODEL_ID=cssupport/mobilebert-sql-injection-detect
SQL_INJECTION_TOKENIZER_ID=google/mobilebert-uncased
SQL_INJECTION_THRESHOLD=0.70
LOG_LEVEL=INFO

# Optional remote integration test
REMOTE_FQDN=envoy-ai-guard.example.com
ALLOW_INSECURE_TLS=false

# Optional Azure Container Instances deployment generation
AZURE_LOCATION=westus3
ACI_RESOURCE_NAME=envoy-ai-guard
ACI_DNS_LABEL=envoy-ai-guard-demo
ACR_SERVER=example.azurecr.io
ACR_USERNAME=replace-me
ACR_PASSWORD=replace-me
AI_GUARD_IMAGE=example.azurecr.io/ai-model-service:latest
WEB_IMAGE=example.azurecr.io/webserver:latest
